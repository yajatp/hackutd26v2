{
  "name": "darkroom",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "test": "tsx --test \"lib/**/*.test.ts\"",
    "st:start": "spacetime start --listen-addr 127.0.0.1:3001",
    "st:publish": "spacetime publish -s http://127.0.0.1:3001 --module-path spacetimedb -y avon",
    "st:generate": "spacetime generate --lang typescript --out-dir lib/module_bindings --module-path spacetimedb",
    "st:ingest": "node scripts/ingest.mjs",
    "test:st": "tsx --test --test-concurrency=1 \"spacetimedb/test/*.test.ts\"",
    "check:hardcode": "node scripts/hardcode-check.mjs",
    "fake:site": "node scripts/make-fake-site.mjs ../eog-data/history/mock_test_2026-10-10T1530 ../eog-data/fake/permian_site --seed 4",
    "smoke": "node scripts/smoke.mjs",
    "demo:darkroom": "node scripts/boot-darkroom.mjs",
    "demo:avon": "node scripts/boot-avon.mjs",
    "demo": "node scripts/boot-avon.mjs",
    "demo:reset": "node scripts/reset-avon.mjs"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/xr": "^6.6.32",
    "next": "15.5.29",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "spacetimedb": "2.14.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.187.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.29",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
